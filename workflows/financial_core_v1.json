{
  "name": "Sovereign_Financial_Core_v1",
  "nodes": [
    {
      "parameters": {
        "rule": "EVERY_DAY",
        "time": "06:00"
      },
      "name": "Daily_Market_Sweep",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "application/json",
        "body": {
          "model": "pplx-70b-online",
          "messages": [
            {
              "role": "system",
              "content": "You are a financial risk analyst. Return ONLY JSON."
            },
            {
              "role": "user",
              "content": "Analyze $AAPL $BTC $TSLA sentiment, SEC filings, and volatility risk for today. Return format: {\"ticker\": \"sentiment_score_0_to_1\", \"risk_level\": \"LOW/MED/HIGH\", \"action\": \"HOLD/SELL/WATCH\"}"
            }
          ]
        },
        "options": {}
      },
      "name": "Perp_Max_Intel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "={{$json.choices[0].message.content}}",
            "typeIfEmpty": "string",
            "valueComparator": "contains"
          },
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{$json.choices[0].message.content}}",
              "rightValue": "SELL",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Risk_Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "channel": "#financial-alerts",
        "text": "SOVEREIGN ALERT: {{$json.choices[0].message.content}}",
        "options": {}
      },
      "name": "Discord_Blast",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetName": "Market_Intel_Log",
        "values": {
          "A": "={{new Date().toISOString()}}",
          "B": "={{$json.choices[0].message.content}}"
        }
      },
      "name": "Log_To_Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Daily_Market_Sweep": {
      "main": [[{"node": "Perp_Max_Intel", "type": "main", "index": 0}]]
    },
    "Perp_Max_Intel": {
      "main": [[{"node": "Risk_Gate", "type": "main", "index": 0}]]
    },
    "Risk_Gate": {
      "main": [
        [{"node": "Discord_Blast", "type": "main", "index": 0}],
        [{"node": "Log_To_Sheets", "type": "main", "index": 0}]
      ]
    }
  }
}
